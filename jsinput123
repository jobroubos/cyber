<script>
(() => {
    // Create the styles
    const style = document.createElement("style");
    style.textContent = `
        #message-overlay {
            position: fixed;
            inset: 0;
            z-index: 99999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(5, 8, 18, .78);
            backdrop-filter: blur(8px);
            font-family: Inter, Arial, sans-serif;
        }

        #message-popup {
            box-sizing: border-box;
            position: relative;
            width: 100%;
            max-width: 540px;
            padding: 32px;
            color: #f4f6ff;
            background: linear-gradient(145deg, #1b2435, #111827);
            border: 1px solid #35435c;
            border-radius: 22px;
            box-shadow: 0 25px 80px #0008;
            animation: popup-in .22s ease-out;
        }

        @keyframes popup-in {
            from { opacity: 0; transform: translateY(12px) scale(.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        #message-popup h2 {
            margin: 0 35px 10px 0;
            font-size: 27px;
        }

        #message-popup p {
            color: #9eacc5;
            line-height: 1.5;
            margin: 0 0 28px;
        }

        #message-popup label {
            display: block;
            margin: 20px 0 9px;
            font-size: 14px;
            font-weight: 600;
            color: #d9e2f4;
        }

        #message-popup input,
        #message-popup textarea {
            box-sizing: border-box;
            display: block;
            width: 100%;
            padding: 15px;
            color: #f4f6ff;
            background: #202b3e;
            border: 1px solid #394861;
            border-radius: 12px;
            font: inherit;
            font-size: 15px;
            outline: none;
            transition: border-color .2s, box-shadow .2s;
        }

        #message-popup textarea {
            min-height: 115px;
            resize: vertical;
        }

        #message-popup input:focus,
        #message-popup textarea:focus {
            border-color: #6485ff;
            box-shadow: 0 0 0 3px #526fff25;
        }

        #message-popup input::placeholder,
        #message-popup textarea::placeholder {
            color: #8998b3;
        }

        #message-close {
            position: absolute;
            top: 20px;
            right: 22px;
            background: none;
            border: none;
            color: #9eacc5;
            font-size: 28px;
            cursor: pointer;
        }

        #message-send {
            width: 100%;
            margin-top: 26px;
            padding: 16px;
            border: 0;
            border-radius: 12px;
            color: white;
            background: linear-gradient(100deg, #3478ff, #6045f5);
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: filter .2s, transform .2s;
        }

        #message-send:hover {
            filter: brightness(1.12);
            transform: translateY(-1px);
        }

        #message-send:disabled {
            opacity: .6;
            cursor: wait;
        }

        #message-status {
            margin: 12px 0 0 !important;
            font-size: 13px;
        }

        @media (max-width: 480px) {
            #message-popup { padding: 25px 20px; }
            #message-popup h2 { font-size: 23px; }
        }
    `;
    document.head.appendChild(style);

    // Create popup elements
    const overlay = document.createElement("div");
    overlay.id = "message-overlay";

    const popup = document.createElement("div");
    popup.id = "message-popup";

    popup.innerHTML = `
        <button id="message-close" aria-label="Close">&times;</button>
        <h2>Send a Message</h2>
        <p>Fill in the details below and we'll send them to our server.</p>

        <form id="message-form">
            <label for="message-name">Name</label>
            <input id="message-name" name="name"
                   placeholder="Enter your name" required maxlength="100">

            <label for="message-text">Message</label>
            <textarea id="message-text" name="message"
                      placeholder="Enter your message"
                      required maxlength="5000"></textarea>

            <button id="message-send" type="submit">➤ &nbsp; Send</button>
            <p id="message-status" role="status"></p>
        </form>
    `;

    overlay.appendChild(popup);
    document.body.appendChild(overlay);

    // Close popup
    function closePopup() {
        overlay.remove();
        style.remove();
    }

    popup.querySelector("#message-close")
        .addEventListener("click", closePopup);

    overlay.addEventListener("click", event => {
        if (event.target === overlay) closePopup();
    });

    document.addEventListener("keydown", function escapeHandler(event) {
        if (event.key === "Escape") {
            closePopup();
            document.removeEventListener("keydown", escapeHandler);
        }
    });

    // Send form data
    popup.querySelector("#message-form")
        .addEventListener("submit", async event => {
            event.preventDefault();

            const name = popup.querySelector("#message-name").value.trim();
            const message = popup.querySelector("#message-text").value.trim();
            const button = popup.querySelector("#message-send");
            const status = popup.querySelector("#message-status");

            if (!name || !message) return;

            button.disabled = true;
            status.textContent = "Sending...";

            try {
                const response = await fetch(
                    "https://www.jobroubos.nl/cybertestschool/receive.php",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({ name, message })
                    }
                );

                if (!response.ok) {
                    throw new Error("Request failed: " + response.status);
                }

                status.textContent = "Message sent successfully!";
                popup.querySelector("#message-form").reset();
            } catch (error) {
                console.error(error);
                status.textContent =
                    "Could not send. Check the server and try again.";
            } finally {
                button.disabled = false;
            }
        });
})();
</script>
